global_defs {
    router_id {{ inventory_hostname }}
}

vrrp_track_process track_haproxy {
    process haproxy
}

vrrp_instance VI_1 {
    state {{ vrrp_state }}
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    priority {{ vrrp_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ vrrp_password }}
    }
    virtual_ipaddress {
        {{ vip }}/24
    }
    track_process {
        track_haproxy
    }
}
