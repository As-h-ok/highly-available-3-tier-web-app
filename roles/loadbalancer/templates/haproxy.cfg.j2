global
    log /dev/log local0
    user haproxy
    group haproxy
    chroot /var/lib/haproxy
    pidfile /var/run/haproxy.pid
    maxconn 2000
    daemon
    stats socket /var/lib/haproxy/stats mode 660 level admin

defaults
    mode http
    log global
    option httplog
    option forwardfor
    option redispatch
    retries 3
    timeout connect 3s
    timeout client 30s
    timeout server 30s

frontend web_front
    bind *:80
    default_backend app_back

backend app_back
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200
{% for h in groups['app'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:80 check inter 2s fall 3 rise 2
{% endfor %}
